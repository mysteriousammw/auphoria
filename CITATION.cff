# CITATION.cff is a TEMPLATE. Fill in real values when the repository is
# published (see docs/PUBLISH_CHECKLIST.md step 9). Leave the repository
# address as REPO_URL_PLACEHOLDER - scripts/set_repo_url.py fills it in.
#
# Authors are people only (no AI tools are authors). Abdul Momin Muhammad
# Wisal is the project creator and lead. The other four people are kept in a
# commented block until each of their [CONFIRM ROLE] markers is replaced with
# the approved role/descriptor - do not uncomment them before then.
#
# version, doi and repository-code are left as placeholders until the first
# release is tagged and (optionally) a DOI is minted.
cff-version: 1.2.0
message: "If you use AUPHORIA in your research or coursework, please cite it as follows."
title: "AUPHORIA"
abstract: "AUPHORIA is an open-source, beginner-friendly data analysis tool for university students who cannot code. It runs offline on a student's own computer or in Google Colab, offers a menu of analyses that fit their data, and produces reproducible reports."
authors:
  - family-names: "Wisal"
    given-names: "Abdul Momin Muhammad"
    email: "ammw@aup.edu.pk"
