    given-names: "Abdul Momin Muhammad"
    email: "ammw@aup.edu.pk"
  - family-names: "Haq"
    given-names: "Ihtesham Ul"
    # Originator of the AUPHORIA idea; reviewed and supervised the project.
  - family-names: "Khan"
    given-names: "Sher Hayat"
    # Reviewed and supervised the project.
  - family-names: "Moheb"
    given-names: "Ahmad Farid"
    # Helped refine the AUPHORIA idea and tested it.
  - family-names: "Anayat"
    given-names: "Mudassir"
    # Helped refine the AUPHORIA idea and tested it.
keywords:
  - statistics
  - data analysis
  - education
  - research methods
  - reproducible research
date-released: "2026-10-29"
version: "0.1.0"
