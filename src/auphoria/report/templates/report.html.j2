<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>AUPHORIA report — {{ analysis_name | e }}</title>
  <style>
    :root { --ink:#1c2733; --muted:#5b6b7a; --accent:#2a6f97; --warn:#b4552d;
            --ok:#2e7d5b; --fail:#a93226; --border:#dde5ec; --bg:#f7f9fb; }
    * { box-sizing: border-box; }
    body { font-family: -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
           color: var(--ink); margin:0; background: var(--bg); line-height:1.55; }
    .wrap { max-width: 900px; margin: 0 auto; padding: 24px 20px 60px; }
    h1 { font-size: 1.6rem; margin: 0 0 2px; }
    h2 { font-size: 1.15rem; margin: 34px 0 8px; border-bottom: 1px solid var(--border); padding-bottom: 4px; }
    h3 { font-size: 1rem; margin: 18px 0 6px; }
    .sub { color: var(--muted); font-size: .92rem; }
    .card { background:#fff; border:1px solid var(--border); border-radius:8px; padding:14px 18px; margin:14px 0; }
    .badge { display:inline-block; background:#eaf2f8; color:var(--accent); border-radius:12px;
             padding:2px 10px; font-size:.78rem; font-weight:600; margin-left:8px; }
    .summary { display:grid; grid-template-columns:repeat(auto-fill,minmax(180px,1fr)); gap:10px; }
    .summ-item { background:#fff; border:1px solid var(--border); border-radius:8px; padding:10px 12px; }
    .summ-label { color:var(--muted); font-size:.78rem; text-transform:uppercase; letter-spacing:.03em; }
    .summ-value { font-size:1.05rem; font-weight:600; margin-top:2px; }
    table.auphoria-table { border-collapse: collapse; width:100%; font-size:.9rem; margin:8px 0; }
    table.auphoria-table th, td { border:1px solid var(--border); padding:5px 8px; text-align:left; }
    table.auphoria-table th { background:#eef3f7; }
    .verdict-PASS { color: var(--ok); font-weight:700; }
    .verdict-WARN { color: var(--warn); font-weight:700; }
    .verdict-FAIL { color: var(--fail); font-weight:700; }
    .warn { border-left:4px solid var(--warn); background:#fdf4ee; padding:10px 14px; border-radius:4px; margin:12px 0; }
    .warn b { color: var(--warn); }
    .expert { border:2px solid var(--fail); background:#fdf0ef; padding:12px 16px; border-radius:6px; margin:14px 0; }
    .expert b { color: var(--fail); }
    .note { color:var(--muted); font-size:.9rem; }
    .doestell { border-left:4px solid var(--accent); background:#f0f6fb; padding:10px 14px; border-radius:4px; margin:12px 0; }
    .fig { margin:16px 0; text-align:center; }
    .fig img { max-width:100%; border:1px solid var(--border); border-radius:8px; }
    .fig figcaption { color:var(--muted); font-size:.85rem; margin-top:4px; }
    .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
            font-size:.82rem; background:#eef2f5; padding:8px 10px; border-radius:6px;
            overflow-x:auto; white-space:pre-wrap; word-break:break-all; }
    code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
           font-size:.85em; background:#eef2f5; padding:1px 4px; border-radius:4px; }
    .dlog { font-size:.82rem; }
    .dlog th { white-space:nowrap; }
    ul { margin:4px 0 8px; }
    a { color: var(--accent); }
    footer { margin-top:40px; color:var(--muted); font-size:.8rem; border-top:1px solid var(--border); padding-top:12px; }
  </style>
</head>
<body>
<div class="wrap">
  <h1>AUPHORIA report <span class="badge">{{ maturity | e }}</span></h1>
  <div class="sub">Analysis: <b>{{ analysis_name | e }}</b>
    &middot; Data: <b>{{ data_name | e }}</b> &middot; Run: {{ run_timestamp | e }}</div>

  {%- if summaries %}
  <h2>Summary</h2>
  <div class="summary">
    {%- for k, v in summaries.items() %}
    <div class="summ-item"><div class="summ-label">{{ k | e }}</div>
      <div class="summ-value">{{ v | e }}</div></div>
    {%- endfor %}
  </div>
  {%- endif %}

  {%- if warnings %}
  <div class="warn"><b>Heads-up:</b><ul>
    {%- for w in warnings %}<li>{{ w | e }}</li>{%- endfor %}
  </ul></div>
  {%- endif %}

  {%- if expert_review %}
  <div class="expert"><b>Needs expert review.</b><ul>
    {%- for r in expert_review %}<li>{{ r | e }}</li>{%- endfor %}
  </ul>
  <p class="note">This is an advanced analysis. It ran, but the conditions shown
     above are outside its intended use, so the numbers need a statistician's
     (or your supervisor's) judgement before you rely on them.</p></div>
  {%- endif %}

  <h2>Quality checks (verdicts)</h2>
  {%- if verdicts %}
  <table class="auphoria-table">
    <tr><th>Result</th><th>Check</th><th>What was checked</th></tr>
    {%- for v in verdicts %}
    <tr>
      <td class="verdict-{{ v.level | e }}">{{ v.level | e }}</td>
      <td>{{ v.check | e }}</td>
      <td>{{ v.message | e }}</td>
    </tr>
    {%- endfor %}
  </table>
  <p class="note">PASS / WARN / FAIL are shown as words so the report is clear
     even if printed in black and white.</p>
  {%- else %}
  <p class="note">No automated quality checks were reported.</p>
  {%- endif %}

  {%- if what_does_not_tell %}
  <h2>What this result does <em>not</em> tell you</h2>
  <div class="doestell"><p>{{ what_does_not_tell | e }}</p></div>
  {%- endif %}

  {%- if methods %}
  <h2>What was done (methods)</h2>
  {%- for m in methods %}<p>{{ m | e }}</p>{%- endfor %}
  {%- endif %}

  {%- if tables %}
  <h2>Results</h2>
  {%- for name, table_html in tables.items() %}
  <h3>{{ name | e }}</h3>{{ table_html | safe }}
  {%- endfor %}
  {%- endif %}

  {%- if figures %}
  <h2>Figures</h2>
  {%- for f in figures %}
  <div class="fig">
    <img src="{{ f.src }}" alt="{{ f.name | e }}">
    {%- if f.caption %}<figcaption>{{ f.caption | e }}</figcaption>{%- endif %}
  </div>
  {%- endfor %}
  {%- endif %}

  {%- if notes and not expert %}
  <h2>Notes for you</h2>
  {%- for n in notes %}<p>{{ n | e }}</p>{%- endfor %}
  {%- endif %}

  {%- if assumptions or limitations %}
  <h2>Assumptions &amp; limitations</h2>
  <div class="card">
    {%- if assumptions %}<p><b>Assumptions</b></p><ul>
      {%- for a in assumptions %}<li>{{ a | e }}</li>{%- endfor %}</ul>{%- endif %}
    {%- if limitations %}<p><b>Limitations</b></p><ul>
      {%- for l in limitations %}<li>{{ l | e }}</li>{%- endfor %}</ul>{%- endif %}
  </div>
  {%- endif %}

  {%- if decision_log %}
  <h2>Decision log</h2>
  <table class="auphoria-table dlog">
    <tr><th>Time</th><th>Level</th><th>Decision</th></tr>
    {%- for ev in decision_log %}
    <tr><td>{{ ev.at | e }}</td><td>{{ ev.level | e }}</td><td>{{ ev.message | e }}</td></tr>
    {%- endfor %}
  </table>
  <p class="note">This log records every warning, assumption check, and whether
     a test was (or was not) run, with the plain-English reason.</p>
  {%- endif %}

  <h2>Reproducibility</h2>
  <div class="card">
    <p>Input file: <code>{{ data_path | e }}</code> (SHA-256 <code>{{ input_sha256 | e }}</code>)</p>
    <p>Random seed: <code>{{ seed | e }}</code></p>
    <p>Re-run this and get the same numbers with:</p>
    <div class="mono">{{ replay | e }}</div>
    <h3>Inputs</h3>
    <table class="auphoria-table"><tr><th>Role</th><th>Column</th></tr>
      {%- for k, v in inputs.items() %}<tr><td><code>{{ k | e }}</code></td><td>{{ v | e }}</td></tr>{%- endfor %}
    </table>
    <h3>Parameters used</h3>
    <table class="auphoria-table"><tr><th>Option</th><th>Value</th></tr>
      {%- for k, v in params.items() %}<tr><td><code>{{ k | e }}</code></td><td>{{ v | e }}</td></tr>{%- endfor %}
    </table>
    <h3>Environment &amp; software versions</h3>
    <table class="auphoria-table"><tr><th>Component</th><th>Version</th></tr>
      {%- for name, version in versions.items() %}<tr><td>{{ name | e }}</td><td>{{ version | e }}</td></tr>{%- endfor %}
    </table>
  </div>

  <footer>Generated by AUPHORIA v{{ auphoria_version | e }}. AUPHORIA never drops
    or imputes your data; treat these results as guidance and discuss them with
    your supervisor. Nothing here is labelled validated.</footer>
</div>
</body>
</html>